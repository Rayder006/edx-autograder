# =============================================================================
# EDX-AUTOGRADER — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais de produção.
# NUNCA versione o arquivo .env (ele já está no .gitignore).
# =============================================================================

# --- Django ---
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=sua_chave_secreta_producao_aqui

# False obrigatório em produção (impede páginas de erro com stack trace)
DJANGO_DEBUG=False

# Domínio real do servidor, separado por vírgula.
# Inclua o IP ou domínio usado pelo EdX. Não inclua http:// ou https://.
DJANGO_ALLOWED_HOSTS=autograder.ime.usp.br,localhost,127.0.0.1

# --- Motor de Correção ---
# pytest  → usa exercises/test_<id>.py  (padrão, recomendado)
# docker  → usa runner.py + tests.json  (legado, seleção explícita)
AUTOGRADER_ENGINE=pytest

# Por padrão, o corretor usa automaticamente o UID do processo Django para
# criar o container de avaliação. Defina apenas se a infraestrutura exigir
# explicitamente outro UID (por exemplo, 1005).
# AUTOGRADER_CONTAINER_USER=1005
AUTOGRADER_TMP_DIR_HOST=/tmp/autograder
# No Compose, o volume interno e o caminho no host são traduzidos automaticamente.
# Para Django executado diretamente no host, AUTOGRADER_TMP_DIR é opcional.
# AUTOGRADER_TMP_DIR=/tmp/autograder
# O fallback local executa código no host e fica DESATIVADO por padrão.
# Nunca habilite em produção.
# AUTOGRADER_ALLOW_LOCAL_FALLBACK=1
AUTOGRADER_WEB_PORT=8000
# O Make usa automaticamente UID/GID do usuário que o executa e o grupo do
# socket Docker. Não execute sudo make. Para iniciar SEM os comandos Make:
# export AUTOGRADER_WEB_UID=$(id -u) AUTOGRADER_WEB_GID=$(id -g)
# export AUTOGRADER_DOCKER_GID=$(stat -Lc '%g' /var/run/docker.sock)  # Linux
# Crie AUTOGRADER_TMP_DIR_HOST com esse mesmo usuário antes do Compose.
# Socket alternativo local, se a infraestrutura exigir:
# AUTOGRADER_DOCKER_SOCKET=/var/run/docker.sock

# --- Banco de Dados (PostgreSQL) ---
# Se POSTGRES_DB estiver definida, o Django usa PostgreSQL. Senão, usa SQLite.
POSTGRES_DB=autograder
POSTGRES_USER=autograder_user
POSTGRES_PASSWORD=sua_senha_forte_postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Porta publicada somente em 127.0.0.1 pelo Compose (não altera a porta interna).
POSTGRES_PORT_HOST=5432

# Alternativa: URL de conexão unificada (tem prioridade sobre as variáveis acima)
# DATABASE_URL=postgres://autograder_user:sua_senha_forte_postgres@localhost:5432/autograder

# --- LTI ---
# Formatos aceitos: chave:segredo, id:chave:segredo ou JSON {"chave":"segredo"}.
# O mesmo par chave/segredo precisa estar cadastrado no EdX Studio.
LTI_PASSPORTS=key_prod:secret_prod_compartilhada
# Alternativamente, configure um único par (sem LTI_PASSPORTS):
# LTI_CONSUMER_KEY=key_prod
# LTI_SHARED_SECRET=secret_prod_compartilhada
# Ative somente durante um diagnóstico; os logs detalhados contêm dados de LTI.
LTI_DEBUG=0
# Se a instituição usa uma CA própria ou proxy para acessar o LMS:
# REQUESTS_CA_BUNDLE=/caminho/ca-institucional.pem
# HTTPS_PROXY=http://proxy.institucional:3128
# O arquivo de CA também deve existir nesse caminho dentro do container web.
